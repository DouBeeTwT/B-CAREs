# Copy to .env and fill in. Never commit .env.
# Only needed when the LLM-written narrative sections of the report are enabled
# (configs/*.yaml -> llm.enabled: true). The pipeline runs fully offline with
# `llm.enabled: false`, which is the default for configs/demo.yaml.

SILICONFLOW_API_KEY=

# Optional overrides
# SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
# B_CARES_LLM_MODEL=deepseek-ai/DeepSeek-V3
